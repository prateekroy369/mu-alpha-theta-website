---
import Base from '../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';

import heroGroup from '../assets/impact/hero-group.jpg';
import celebration from '../assets/impact/celebration-backpacks.jpg';
import handoff1 from '../assets/impact/handoff-1.jpg';
import handoff2 from '../assets/impact/handoff-2.jpg';
import handoff3 from '../assets/impact/handoff-3.jpg';
import handoff4 from '../assets/impact/handoff-4.jpg';
import handoff5 from '../assets/impact/handoff-5.jpg';
import handoff6 from '../assets/impact/handoff-6.jpg';
import handoff7 from '../assets/impact/handoff-7.jpg';
import candidGroup from '../assets/impact/candid-group.jpg';
import d2_01 from '../assets/impact/drive2/01.jpg';
import d2_02 from '../assets/impact/drive2/02.jpg';
import d2_03 from '../assets/impact/drive2/03.jpg';
import d2_04 from '../assets/impact/drive2/04.jpg';
import d2_05 from '../assets/impact/drive2/05.jpg';
import d2_06 from '../assets/impact/drive2/06.jpg';
import d2_07 from '../assets/impact/drive2/07.jpg';
import d2_08 from '../assets/impact/drive2/08.jpg';
import d2_09 from '../assets/impact/drive2/09.jpg';
import d2_10 from '../assets/impact/drive2/10.jpg';
import d2_11 from '../assets/impact/drive2/11.jpg';
import d2_12 from '../assets/impact/drive2/12.jpg';
import d2_13 from '../assets/impact/drive2/13.jpg';
import d2_14 from '../assets/impact/drive2/14.jpg';
import d2_15 from '../assets/impact/drive2/15.jpg';
import d2_16 from '../assets/impact/drive2/16.jpg';
import d2_17 from '../assets/impact/drive2/17.jpg';

const photos = [
  { src: heroGroup, alt: 'Students and families gather with our team banner at the Giving Drive in West Bengal' },
  { src: celebration, alt: 'Students hold up their new backpacks and school supplies' },
  { src: handoff1, alt: 'A volunteer hands a new backpack to a student' },
  { src: handoff2, alt: 'A volunteer hands school supplies to a student' },
  { src: handoff3, alt: 'A volunteer hands a backpack to a student in front of the Giving Drive banner' },
  { src: handoff4, alt: 'A volunteer hands supplies to a student' },
  { src: handoff5, alt: 'Volunteers distribute backpacks to a group of students' },
  { src: handoff6, alt: 'A volunteer hands supplies to a student' },
  { src: handoff7, alt: 'A volunteer hands a backpack to a student' },
  { src: candidGroup, alt: 'Volunteers and students at the Giving Drive' },
];

const photos2 = [
  { src: d2_09, alt: 'Students hold up new books and school supplies in front of the Mu Alpha Theta banner at the second Giving Drive' },
  { src: d2_08, alt: 'A seated group of students proudly holds up their new books' },
  { src: d2_07, alt: 'Students and volunteers gather around the banner with their new supplies' },
  { src: d2_13, alt: 'Students lift their new books and supplies high with teachers and volunteers' },
  { src: d2_12, alt: 'Students and volunteers pose together after the distribution' },
  { src: d2_01, alt: 'Students sit on the floor of the school hall as the distribution begins' },
  { src: d2_04, alt: 'Tables stacked with books, clothing, and school supplies beneath the Mu Alpha Theta banner' },
  { src: d2_02, alt: 'A student receives her new supplies from a table of books and clothing' },
  { src: d2_06, alt: 'A volunteer hands a student her new supplies' },
  { src: d2_03, alt: 'A girl in a new dress stands in front of the banner' },
  { src: d2_10, alt: 'Volunteers help a student choose her supplies as classmates look on' },
  { src: d2_05, alt: 'A young boy receives a new set of clothes' },
  { src: d2_11, alt: 'A volunteer hands a young boy a gift' },
  { src: d2_14, alt: 'Girls line up in their new dresses' },
  { src: d2_15, alt: 'A row of girls smile in their new dresses' },
  { src: d2_16, alt: 'Girls stand together in their new dresses' },
  { src: d2_17, alt: 'Children stand proudly in their new clothes' },
];
const gallery = await Promise.all(
  photos.map(async (p) => {
    const full = await getImage({ src: p.src, width: 1600, format: 'webp' });
    return { ...p, full: full.src };
  })
);

const gallery2 = await Promise.all(
  photos2.map(async (p) => {
    const full = await getImage({ src: p.src, width: 1600, format: 'webp' });
    return { ...p, full: full.src };
  })
);
---

<Base title="Our Impact — Mu Alpha Theta" description="Photos from our Giving Drive at a village school in West Bengal, India — where the funds raised through our math coaching became backpacks, school supplies, and support for underprivileged children.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Our Impact</p>
      <h1 style="max-width: 24ch;">Where the giving actually goes.</h1>
      <p class="lead">
        Every family we coach is invited to support underprivileged children in India. That
        support has now become two <strong>Giving Drives</strong> — backpacks, books, clothing, and
        school supplies handed directly to students who needed them, organized on the ground by
        our founders' family.
      </p>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <p class="eyebrow">Giving Drive 1 · July 11, 2026</p>
      <h2 class="drive-title">A village school in West Bengal</h2>
      <p class="lead drive-lead">Backpacks, notebooks, and school supplies for students at a village school.</p>
      <div class="gallery-grid">
        {gallery.map((p, i) => (
          <button class="gallery-item" type="button" data-full={p.full} aria-label={`View photo ${i + 1} of ${gallery.length}`}>
            <Image src={p.src} alt={p.alt} widths={[320, 640]} sizes="(max-width: 600px) 50vw, (max-width: 1000px) 33vw, 25vw" />
          </button>
        ))}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <p class="eyebrow">Giving Drive 2 · September 19, 2026</p>
      <h2 class="drive-title">The giving continues in West Bengal</h2>
      <p class="lead drive-lead">Books, new clothes, and school supplies for another group of village students — thanks to the families who supported us.</p>
      <div class="gallery-grid">
        {gallery2.map((p, i) => (
          <button class="gallery-item" type="button" data-full={p.full} aria-label={`View Giving Drive 2 photo ${i + 1} of ${gallery2.length}`}>
            <Image src={p.src} alt={p.alt} widths={[320, 640]} sizes="(max-width: 600px) 50vw, (max-width: 1000px) 33vw, 25vw" />
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap center">
      <h2 style="max-width:28ch; margin-inline:auto;">This is what your gift makes possible.</h2>
      <p class="lead" style="max-width:44ch; margin-inline:auto;">
        Every contribution — of any size — goes directly toward moments like these.
      </p>
      <div style="margin-top:1.5rem;">
        <a class="btn btn--primary" href="/support/">Support the next drive</a>
      </div>
    </div>
  </section>

  <div id="lightbox" class="lightbox" hidden>
    <button class="lightbox__close" type="button" aria-label="Close">&times;</button>
    <img class="lightbox__img" src="" alt="" />
  </div>
</Base>

<style>
  .drive-title { margin-top: 0.25rem; }
  .drive-lead { margin-bottom: 1.5rem; max-width: 56ch; }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.85rem;
  }
  .gallery-item {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: var(--shadow);
    line-height: 0;
  }
  .gallery-item :global(img) {
    display: block;
    width: 100%;
    height: 230px;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .gallery-item:hover :global(img) { transform: scale(1.05); }
  .gallery-item:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(20, 15, 17, 0.92);
  }
  .lightbox[hidden] { display: none; }
  .lightbox__img {
    max-width: 92vw;
    max-height: 88vh;
    border-radius: 8px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5);
  }
  .lightbox__close {
    position: absolute;
    top: 0.75rem;
    right: 1.5rem;
    font-size: 2.75rem;
    line-height: 1;
    color: #fff;
    background: none;
    border: 0;
    cursor: pointer;
  }
</style>

<script>
  const lb = document.getElementById('lightbox');
  if (lb) {
    const lbImg = lb.querySelector('.lightbox__img');
    const closeBtn = lb.querySelector('.lightbox__close');

    const open = (full, alt) => {
      lbImg.src = full;
      lbImg.alt = alt;
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lb.hidden = true;
      lbImg.src = '';
      document.body.style.overflow = '';
    };

    document.querySelectorAll('.gallery-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const img = btn.querySelector('img');
        open(btn.dataset.full, img ? img.alt : '');
      });
    });
    closeBtn.addEventListener('click', close);
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lb.hidden) close(); });
  }
</script>
